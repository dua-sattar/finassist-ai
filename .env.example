# Copy this file to .env and fill in real values locally.
# Never commit the real .env file.

# OpenAI API key used for chat completions and embeddings.
OPENAI_API_KEY=

# Chat model used by the LangGraph agent.
OPENAI_MODEL=gpt-4o-mini

# Embedding model used by the RAG pipeline.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Path to the local SQLite database file (mock CRM).
SQLITE_DB_PATH=./database/finassist.db

# Directory where the Chroma vector store persists embeddings.
VECTOR_DB_DIR=./rag/vector_store

# development | production
APP_ENV=development
