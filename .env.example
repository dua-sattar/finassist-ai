# Copy this file to .env and fill in real values locally.
# Never commit the real .env file.

# Groq API key (free tier, no credit card) used for chat completions / the
# LangGraph agent / document summaries. Get one at console.groq.com/keys
GROQ_API_KEY=

# Chat model used by the LangGraph agent and document summaries.
GROQ_MODEL=llama-3.3-70b-versatile

# Local sentence-transformers model used for RAG embeddings -- runs on your
# machine, no API key or cost. Downloaded automatically on first use.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Path to the local SQLite database file (mock CRM).
SQLITE_DB_PATH=./database/finassist.db

# Directory where the Chroma vector store persists embeddings.
VECTOR_DB_DIR=./rag/vector_store

# development | production
APP_ENV=development
